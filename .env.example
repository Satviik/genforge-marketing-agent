GENFORGE_MARKETING_ENV=development
GENFORGE_MARKETING_LOG_LEVEL=INFO
GENFORGE_MARKETING_DATA_DIR=./data

# Existing GenForge screening CLI
GENFORGE_MARKETING_SCREENING_COMMAND=genforge
# Example when both repositories are cloned as sibling folders.
GENFORGE_MARKETING_SCREENING_WORKDIR=../gen-forge-screening-agent
GENFORGE_MARKETING_SCREENING_TIMEOUT_SECONDS=120

# Optional GitHub API token; helps avoid anonymous API rate limits.
GENFORGE_MARKETING_GITHUB_TOKEN=

# AI provider (leave empty for deterministic/local mode)
GENFORGE_AI_PROVIDER=
GENFORGE_AI_API_KEY=
GENFORGE_AI_MODEL=

# Publishing remains disabled until explicitly configured.
INSTAGRAM_PUBLISHING_ENABLED=false
